# Contact2Sale (Lopes) — server-only, lê via runtimeConfig (Nuxt)
NUXT_C2S_TOKEN=
NUXT_C2S_BASE_URL=https://lopesnet.contact2sale.com/integration

# Database — Postgres (docker-compose local ou Railway)
DATABASE_URL=postgresql://lopes:lopes@localhost:5432/lopes_bahia

# Sessions — assinatura do cookie HttpOnly. Mínimo 32 caracteres.
NUXT_SESSION_PASSWORD=
